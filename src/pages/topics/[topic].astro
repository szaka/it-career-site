---
import ReadingTime from '../../components/ReadingTime.astro';
import { getCollection } from 'astro:content';
import PortfolioPage from '../../layouts/PortfolioPage.astro';
import FormattedDate from '../../components/FormattedDate.astro';
import TopicLinks from '../../components/TopicLinks.astro';
import { projectTopics, topicSlug } from '../../data/topics';

export async function getStaticPaths() {
  const posts = (await getCollection('blog'))
    .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf() || a.data.title.localeCompare(b.data.title));

  const labels = new Map<string, string>();
  for (const tags of [...posts.map((post) => post.data.tags ?? []), ...projectTopics.map((project) => project.tags)]) {
    for (const label of tags) {
      const slug = topicSlug(label);
      if (slug && !labels.has(slug)) labels.set(slug, label);
    }
  }

  return Array.from(labels, ([topic, label]) => ({
    params: { topic },
    props: {
      label,
      articles: posts.filter((post) => (post.data.tags ?? []).some((tag) => topicSlug(tag) === topic)),
      projects: projectTopics.filter((project) => project.tags.some((tag) => topicSlug(tag) === topic)),
    },
  }));
}

const { label, articles, projects } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<PortfolioPage title={`${label} | Shahid Zaka`} description={`Articles and projects about ${label}.`}>
  <h1>{label}</h1>

  {articles.length > 0 && (
    <section class="portfolio-section">
      <h2>Articles</h2>
      <ul class="topic-results">
        {articles.map((post) => (
          <li>
            <h3><a href={`${base}/blog/${post.id}/`}>{post.data.title}</a></h3>
            <div class="entry-meta">
              <span class="entry-facts"><FormattedDate date={post.data.pubDate} /><ReadingTime body={post.body} /></span>
              <TopicLinks tags={post.data.tags ?? []} />
            </div>
            <p>{post.data.description}</p>
          </li>
        ))}
      </ul>
    </section>
  )}

  {projects.length > 0 && (
    <section class="portfolio-section">
      <h2>Projects</h2>
      <ul class="topic-results">
        {projects.map((project) => (
          <li><a href={`${base}/projects/${project.id}/`}>{project.title}</a></li>
        ))}
      </ul>
    </section>
  )}

  <p class="portfolio-links">
    <a href={`${base}/blog/`}>All articles</a>
    <a href={`${base}/projects/`}>All projects</a>
  </p>
</PortfolioPage>
