---
import { getCollection } from 'astro:content';
import PortfolioPage from '../layouts/PortfolioPage.astro';
import { SITE_TITLE } from '../consts';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const posts = (await getCollection('blog'))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf() || a.data.title.localeCompare(b.data.title))
  .slice(0, 2);
---

<PortfolioPage title={SITE_TITLE} description="IT support labs, projects, and troubleshooting notes by Shahid Zaka.">
  <h1>{SITE_TITLE}</h1>
  <p class="portfolio-intro">I’m building my IT support portfolio through hands-on labs and projects. I document what I tried, how I diagnosed problems, and how I verified the result.</p>
  <p class="portfolio-links">
    <a href={`${base}/projects/`}>View projects</a>
    <a href={`${base}/blog/`}>Read the blog</a>
    <a href="https://github.com/szaka">GitHub</a>
  </p>

  <section class="portfolio-section">
    <h2>Featured project</h2>
    <h3><a href={`${base}/projects/#astro-portfolio`}>Deploying the Astro portfolio</a></h3>
    <p class="portfolio-summary">I set up automated publishing with GitHub Actions and fixed a blog link that broke under the GitHub Pages project path.</p>
  </section>

  {posts.length > 0 && (
    <section class="portfolio-section">
      <h2>Latest writing</h2>
      {posts.map((post) => (
        <div class="home-post">
          <h3><a href={`${base}/blog/${post.id}/`}>{post.data.title}</a></h3>
          <p class="portfolio-summary">{post.data.description}</p>
        </div>
      ))}
    </section>
  )}
</PortfolioPage>
