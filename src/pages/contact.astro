---
import suffolkCountyMap from '../assets/suffolk-county-map.svg?url';
import PortfolioPage from '../layouts/PortfolioPage.astro';

---

<PortfolioPage
  title="Contact | Shahid Zaka"
  description="Connect with Shahid Zaka about IT support roles, portfolio projects, and technical documentation."
>
  <h1>Contact</h1>
  <p class="portfolio-intro">
    I’m pursuing IT support and help desk roles. If you’re hiring or have a
    question about a project, LinkedIn is the best way to reach me.
  </p>

  <p class="contact-actions">
    <a class="contact-primary" href="https://www.linkedin.com/in/shahid-zaka/" data-contact-primary>
      Connect on LinkedIn <svg width="16" height="16" viewBox="0 0 16 16"
        fill="none" stroke="currentColor" stroke-width="1.5"
        aria-hidden="true" focusable="false">
        <path d="M2 8h11M9 4l4 4-4 4" />
      </svg>
    </a>
  </p>

  <section class="portfolio-section" aria-labelledby="contact-topics">
    <h2 id="contact-topics">What to reach out about</h2>
    <ul>
      <li>IT support, help desk, or desktop support opportunities.</li>
      <li>Questions about a lab, troubleshooting write-up, or project.</li>
    </ul>
    <p>If you’re reaching out about a role, a link to the posting or a short description is helpful.</p>
  </section>

  <section class="portfolio-section" aria-labelledby="contact-location">
    <h2 id="contact-location">Location</h2>
    <p>Suffolk County, New York</p>
    <figure class="contact-location-map">
      <img src={suffolkCountyMap} alt="Suffolk County highlighted on eastern Long Island"
        width="640" height="226" loading="lazy" decoding="async" />
      <figcaption>
        Boundaries from the U.S. Census Bureau.{" "}
        <a href="https://www.openstreetmap.org/#map=9/40.91/-72.76"
          rel="noreferrer" referrerpolicy="no-referrer">View on OpenStreetMap</a>
      </figcaption>
    </figure>
  </section>
</PortfolioPage>

<style>
  .contact-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: .5rem 1rem;
  }

  .contact-primary {
    display: inline-flex;
    align-items: center;
    gap: .6rem;
    min-height: 2.75rem;
    padding: .4rem .85rem;
    border: 1px solid var(--pj-link);
    border-radius: .35rem;
    background: var(--pj-tint);
    font-weight: 650;
  }

  .contact-primary:hover {
    border-color: var(--pj-ink);
  }
</style>





<style>
  /* Contact action hierarchy */
  a[data-contact-primary],
  button[data-contact-map] {
    box-sizing: border-box;
    min-height: 44px;
    font: inherit;
    font-size: .9375rem;
    font-weight: 600;
    color: var(--pj-link, currentColor);
  }

  a[data-contact-primary] {
    display: inline-flex;
    align-items: center;
    padding: .45rem .8rem;
    border: 1px solid var(--pj-line, currentColor);
    border-radius: var(--control-radius, .35rem);
    background: var(--pj-card);
    text-decoration: none;
  }

  a[data-contact-primary]:hover {
    border-color: currentColor;
  }

  button[data-contact-map] {
    padding: 0;
    border: 0;
    background: transparent;
    text-decoration: underline;
    text-underline-offset: .16em;
    cursor: pointer;
  }

  :is(a[data-contact-primary], button[data-contact-map]):focus-visible {
    outline: 2px solid currentColor;
    outline-offset: 3px;
  }
</style>

<style>
  /* Local Contact map */
  .contact-location-map { margin: 1rem 0 0; }
  .contact-location-map img { display: block; max-width: 100%; height: auto; }
  .contact-location-map figcaption { margin-block-start: .5rem; font-size: .875rem; }
</style>
