---
import ResumeLink from '../components/ResumeLink.astro';
import PortfolioPage from '../layouts/PortfolioPage.astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<PortfolioPage
  title="About | Shahid Zaka"
  description="Shahid Zaka’s hands-on experience with IT support, home networking, and technical documentation."
>
  <h1 id="about-page-title">About</h1>
  <div class="about-intro">
    <p class="portfolio-intro">
    My hands-on experience includes setting up home networks, Wi-Fi, servers,
    and shared storage. I also taught basic computer classes at a Brooklyn
    nonprofit, where I practiced explaining technical steps in plain language.
  </p>
  <p>
    When someone needs help, I ask what they were trying to do and what
    happened instead. I test one change at a time, ask them to try the
    original task again, and document the steps that helped resolve the problem.
  </p>
    <div class="resume-action"><ResumeLink /></div>
  </div>

<section class="portfolio-section" id="certifications"
    aria-labelledby="certification-progress-heading">
    <h2 id="certification-progress-heading">Certification progress</h2>
    <ul>
      <li>CompTIA Tech+ — Studying</li>
      <li>CompTIA A+, Network+ &amp; Security+ — Training in progress</li>
      <li>Google IT Support Professional Certificate — Planned study</li>
    </ul>
  </section>

  <section class="portfolio-section about-site-notes" aria-labelledby="about-site-heading">
    <h2 id="about-site-heading">About this site</h2>
    <p>
      I built this site to keep track of what I’m learning and share the
      problems I work through. Each write-up explains what I tried, what
      happened, and how I checked the result.
    </p>
    <p>
      I write in Markdown, edit with VS Code or Pages CMS, and preview changes
      locally with Astro. Git tracks my changes, and GitHub Actions builds
      the site for GitHub Pages.
    </p>
    <p class="portfolio-links">
      <a href="https://github.com/szaka/it-career-site">View the source on GitHub</a>
      <a href={`${import.meta.env.BASE_URL.replace(/\/$/, '')}/projects/astro-portfolio/`}>Read how I built the site</a>
    </p>

    <h3>Tools and guides I used</h3>
    <p>These tools and their documentation helped me build, publish, and check the site.</p>
    <ul data-about-resources>
      <li>
        <strong>Writing and editing.</strong>{" "}
        <a href="https://docs.astro.build/en/guides/markdown-content/">Astro and Markdown</a>,{" "}
        <a href="https://code.visualstudio.com/docs/languages/markdown">VS Code</a>, and{" "}
        <a href="https://pagescms.org/docs/quick-start/">Pages CMS</a>.
      </li>
      <li>
        <strong>Publishing.</strong>{" "}
        <a href="https://git-scm.com/docs">Git</a>,{" "}
        <a href="https://docs.npmjs.com/cli/commands/npm-ci">npm</a>,{" "}
        <a href="https://docs.astro.build/en/guides/deploy/github/">GitHub Actions and Pages</a>, and{" "}
        <a href="https://www.namecheap.com/support/knowledgebase/article.aspx/434/2237/how-do-i-set-up-host-records-for-a-domain/">Namecheap DNS</a>.
      </li>
      <li>
        <strong>Readability and testing.</strong>{" "}
        <a href="https://brailleinstitute.org/freefont">Atkinson Hyperlegible</a>{" "}
        provides the fonts. I use{" "}
        <a href="https://www.w3.org/TR/WCAG22/">WCAG 2.2</a>{" "}
        as an accessibility reference and{" "}
        <a href="https://playwright.dev/docs/accessibility-testing">Playwright with axe</a>{" "}
        for automated browser checks.
      </li>
    </ul>
    <p>
      Read the{" "}
      <a href={`${import.meta.env.BASE_URL.replace(/\/$/, '')}/privacy/`}>Privacy page</a>{" "}
      for details about hosting, optional analytics, and the map.
    </p>
  </section>

  <section class="portfolio-section" aria-labelledby="accessibility-heading">
    <h2 id="accessibility-heading">Accessibility</h2>
    <p>
      I check this site at narrow and wide screen sizes in both light and dark
      modes. If you have trouble reading a page or using a control, please
      let me know through the <a href={`${import.meta.env.BASE_URL.replace(/\/$/, '')}/contact/`}>Contact page</a>. If you can, include the page and what you were trying to do.
    </p>
  </section>

</PortfolioPage>

<style>
  .skills-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: .75rem;
    margin-block-start: .85rem;
  }

  .skill-card {
    min-width: 0;
    padding: .85rem 1rem;
    border: 1px solid var(--pj-line);
    border-radius: .45rem;
    background: var(--pj-card);
  }

  .skill-card h3 { margin: 0 0 .35rem; }
  .skill-card ul {
    margin: 0;
    padding-inline-start: 1.15rem;
    color: var(--pj-muted);
    font-size: .9375rem;
  }

  @media (max-width: 36rem) {
    .skills-grid { grid-template-columns: 1fr; }
  }
</style>


<style>
  .about-intro {
    max-width: 61ch;
  }

  .about-intro > p {
    text-wrap: pretty;
  }

  .about-intro .about-resume {
    margin-block: .9rem 0;
    font-size: .9375rem;
  }

  .about-resume:empty {
    display: none;
  }

  .certification-progress {
    margin-block: 1rem 1.75rem;
    padding: .85rem 1rem;
    border: 1px solid var(--pj-line);
    border-radius: .45rem;
    background: var(--pj-card);
  }

  .certification-progress h2 {
    font-size: 1.2rem;
    margin-block: 0 .35rem;
  }

  .certification-progress ul {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .certification-progress li {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    flex-wrap: wrap;
    gap: .25rem .85rem;
    padding-block: .55rem;
    font-size: .9375rem;
  }

  .certification-progress li + li {
    border-top: 1px solid var(--pj-line);
  }

  .certification-status {
    background: var(--pj-tint);
    color: var(--pj-ink);
    border-radius: .25rem;
    padding: .1rem .45rem;
    font-size: .8125rem;
  }
</style>

<style>
  /* About resource list spacing */
  [data-about-resources] > li + li {
    margin-block-start: 0.65rem;
  }
</style>

<style is:global>
  /* About page hierarchy */
  .about-site-notes > section {
    margin: 1rem 0 0;
    padding: 0;
    border: 0;
  }

  .about-site-notes h3 {
    margin-block: 0 .4rem;
    font-size: 1.15rem;
  }

  /* Flatten the skill cards and certification panel around their headings. */
  [data-about-skills] + * > *,
  :is(section, div):has(> [data-about-certifications]),
  :is(aside, section)#ai-use {
    border: 0;
    border-radius: 0;
    background: transparent;
    box-shadow: none;
    padding-inline: 0;
  }

  [data-about-skills] + * {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: .85rem 1.5rem;
  }

  @media (max-width: 36rem) {
    [data-about-skills] + * {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  :is(section, div):has(> [data-about-certifications])
    :is(li, p) > :last-child:not(a) {
    background: transparent;
    border: 0;
    padding-inline: 0;
  }

  :is(aside, section)#ai-use {
    border-block-start: 1px solid var(--pj-line);
  }
</style>


<style is:global>
  /* About reading layout */
  main:has(#about-page-title) {
    --about-reading-width: 65ch;
  }

  main:has(#about-page-title) :is(.portfolio-intro, p) {
    max-inline-size: var(--about-reading-width);
  }

  main:has(#about-page-title) .portfolio-section {
    margin-block-start: 1.75rem;
    padding-block-start: 1.25rem;
  }

  main:has(#about-page-title) [data-about-skills] + * {
    gap: 1rem 1.5rem;
    margin-block: .75rem 1rem;
  }

  main:has(#about-page-title) [data-about-skills] + * > * {
    margin: 0;
    padding: 0;
  }

  main:has(#about-page-title) [data-about-skills] + * :is(h3, h4) {
    margin: 0 0 .25rem;
    font-size: 1rem;
  }

  main:has(#about-page-title) [data-about-skills] + * ul {
    margin: 0;
    padding-inline-start: 1.2em;
  }

  main:has(#about-page-title) .about-site-notes > section {
    margin-block-start: .85rem;
    padding: 0;
  }

  main:has(#about-page-title) .about-site-notes > section > p {
    margin-block: .35rem .65rem;
  }

  main:has(#about-page-title) #ai-use {
    background: transparent;
    box-shadow: none;
    padding-inline: 0;
  }
</style>


<style is:global>
  /* About print layout */
  @media print {
    body:has(#about-page-title) :is(.portfolio-header, .portfolio-footer, .breadcrumbs) {
      display: none;
    }

    main:has(#about-page-title) {
      width: 100%;
      max-width: none;
      margin: 0;
      padding: 0;
      background: white;
      color: black;
      font-size: 11pt;
    }

    main:has(#about-page-title) :is(h1, h2, h3, p, li, a) {
      color: black;
    }

    main:has(#about-page-title) :is(h1, h2, h3, summary) {
      break-after: avoid;
    }

    main:has(#about-page-title) :is(p, li) {
      orphans: 2;
      widows: 2;
    }

    main:has(#about-page-title) :is(.portfolio-section, #ai-use) {
      margin-block: 1rem 0;
      padding: 0;
      border: 0;
      background: transparent;
      box-shadow: none;
    }
  }
</style>
