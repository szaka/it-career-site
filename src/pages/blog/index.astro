---
import { getCollection } from 'astro:content';
import FormattedDate from '../../components/FormattedDate.astro';
import PortfolioPage from '../../layouts/PortfolioPage.astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const starterPosts = new Set([
  'first-post', 'second-post', 'third-post', 'markdown-style-guide', 'using-mdx',
]);
const posts = (await getCollection('blog'))
  .filter((post) => !starterPosts.has(post.id))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---

<PortfolioPage title="Blog | Shahid Zaka" description="IT support labs, troubleshooting notes, and project write-ups.">
  <h1>Blog</h1>
  <ul class="portfolio-posts">
    {posts.map((post) => (
      <li class="portfolio-section">
        <h2><a href={`${base}/blog/${post.id}/`}>{post.data.title}</a></h2>
        <p class="portfolio-date"><FormattedDate date={post.data.pubDate} /></p>
        <p>{post.data.description}</p>
      </li>
    ))}
  </ul>
</PortfolioPage>
