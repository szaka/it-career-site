---
import { existsSync } from 'node:fs';
import { resolve } from 'node:path';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const filename = 'shahid-zaka-resume.pdf';
const hasFinal = existsSync(resolve('public', filename));
const sample = !hasFinal && import.meta.env.DEV
  ? (await import('../assets/shahid-zaka-resume-sample.pdf?url')).default
  : undefined;
---

{(hasFinal || sample) && (
  <a class="resume-link" href={hasFinal ? `${base}/${filename}` : sample}>
    <svg width="18" height="18" viewBox="0 0 24 24" fill="none"
      stroke="currentColor" stroke-width="1.5" stroke-linecap="round"
      stroke-linejoin="round" aria-hidden="true" focusable="false">
      <path d="M14 3H6a1 1 0 0 0-1 1v16a1 1 0 0 0 1 1h12a1 1 0 0 0 1-1V8z" />
      <path d="M14 3v5h5M8 13h8M8 16h6" />
    </svg>
    <span>{hasFinal ? 'View résumé (PDF)' : 'Preview résumé (sample PDF)'}</span>
  </a>
)}

<style>
  .resume-link {
    display: inline-flex;
    align-items: center;
    gap: .4rem;
  }

  .resume-link svg {
    flex: none;
  }
</style>


<style>
  /* Shared résumé action */
  body:has(.portfolio-header) main a.resume-link[href] {
    min-height: 44px;
    color: var(--pj-link);
    font-size: .9375rem;
    font-weight: 550;
    text-decoration: none !important;
  }
</style>

<style is:global>
  a.resume-link {
    display: inline-flex;
    align-items: center;
    gap: 0.4em;
    font-size: 0.9375rem;
    text-decoration: none;
  }

  a.resume-link:hover,
  a.resume-link:focus-visible {
    text-decoration: none;
  }
</style>

<style is:global>
  /* Shared résumé button */
  a.resume-link[href],
  a.resume-link[href]:hover,
  a.resume-link[href]:focus-visible {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    box-sizing: border-box;
    min-height: 44px;
    padding: 0.45rem 0.8rem;
    border: 1px solid var(--pj-border, currentColor);
    border-radius: 0.35rem;
    background: var(--pj-card);
    color: var(--pj-link);
    font-weight: 600;
    text-decoration: none !important;
  }

  a.resume-link[href]:hover {
    border-color: currentColor;
  }

  a.resume-link[href]:focus-visible {
    outline: 2px solid currentColor;
    outline-offset: 3px;
  }

  a.resume-link[href] svg {
    flex-shrink: 0;
    margin-inline-end: 0;
  }
</style>

<style is:global>
  /* Shared outlined résumé action */
  .home-resume-action:has(a) {
    margin-block-start: 1rem;
  }

  .resume-action a.resume-link[href]:any-link {
    display: inline-flex;
    align-items: center;
    gap: .45rem;
    box-sizing: border-box;
    min-height: 44px;
    max-width: 100%;
    padding: .45rem .8rem;
    border: 1px solid var(--pj-line, currentColor);
    border-radius: var(--control-radius, .35rem);
    background: var(--pj-card);
    color: var(--pj-link);
    font-weight: 600;
    text-decoration: none !important;
  }

  .resume-action a.resume-link[href]:any-link:hover {
    border-color: currentColor;
  }

  .resume-action a.resume-link[href]:any-link:focus-visible {
    outline: 2px solid currentColor;
    outline-offset: 3px;
  }

  /* Keep outlined résumé labels unadorned. */
  body main .resume-action a.resume-link[href]:any-link {
    text-decoration: none !important;
    background-image: none !important;
    box-shadow: none !important;
  }

  body main .resume-action a.resume-link[href]:any-link :is(span, strong) {
    text-decoration: none !important;
    border-block-end: 0 !important;
    background-image: none !important;
    box-shadow: none !important;
  }
</style>
