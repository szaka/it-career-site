---
import { topicSlug } from '../data/topics';

interface Props {
  tags: string[];
}

const { tags } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

{tags.length > 0 && (
  <ul class="topic-links" aria-label="Topics">
    {tags.map((tag) => <li><a href={`${base}/topics/${topicSlug(tag)}/`}>{tag}</a></li>)}
  </ul>
)}
