---
import AnalyticsConsent from './AnalyticsConsent.astro';
import { SITE_TITLE } from '../consts';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<footer class="portfolio-footer">
  <span>© {new Date().getFullYear()} {SITE_TITLE}</span>
  <div class="portfolio-links">
    <a href={`${base}/privacy/`}>Privacy</a>
    <a href={`${base}/rss.xml`}>RSS</a>
    <a href="https://github.com/szaka">GitHub</a>
    <a href="https://www.linkedin.com/in/shahid-zaka/">LinkedIn</a>
    <button type="button" data-footer-settings-toggle
      aria-expanded="false" aria-controls="footer-settings">Settings</button>
  </div>

  <div class="footer-settings" id="footer-settings" hidden>
    <div class="footer-settings-controls">
      <label class="site-appearance" hidden>
        Appearance:
        <select id="site-appearance">
          <option value="system">System</option>
          <option value="light">Light</option>
          <option value="dark">Dark</option>
        </select>
      </label>
      <AnalyticsConsent />
    </div>
  </div>
</footer>

<style>
</style>



<script>
  const settingsToggle = document.querySelector<HTMLButtonElement>('[data-footer-settings-toggle]');
  const settingsPanel = document.getElementById('footer-settings');

  settingsToggle?.addEventListener('click', () => {
    if (!settingsPanel) return;
    settingsPanel.hidden = !settingsPanel.hidden;
    settingsToggle.setAttribute('aria-expanded', String(!settingsPanel.hidden));
  });

  const appearanceControl = document.querySelector<HTMLSelectElement>('#site-appearance');
  if (appearanceControl) {
    const root = document.documentElement;
    appearanceControl.value = root.dataset.siteAppearance ?? 'system';
    appearanceControl.closest('label')?.removeAttribute('hidden');
    appearanceControl.addEventListener('change', () => {
      const mode = appearanceControl.value;
      if (mode === 'system') delete root.dataset.siteAppearance;
      else root.dataset.siteAppearance = mode;
      try { localStorage.setItem('portfolio-home-appearance', mode); } catch {}
    });
  }
</script>

<style>
  [data-footer-settings-toggle] {
    padding: 0;
    border: 0;
    background: transparent;
    color: var(--pj-link, currentColor);
    font: inherit;
    cursor: pointer;
  }

  [data-footer-settings-toggle]:hover,
  [data-footer-settings-toggle][aria-expanded="true"] {
    text-decoration: underline;
    text-underline-offset: .16em;
  }

  .footer-settings[hidden] {
    display: none;
  }

  .footer-settings {
    flex-basis: 100%;
    min-width: 0;
    padding-block-start: .75rem;
    border-top: 1px solid var(--pj-line);
  }

  .footer-settings-controls {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: .5rem 1.25rem;
  }

  .footer-settings-controls :global(.analytics-settings) {
    flex: 1 1 16rem;
    min-width: 0;
  }

  .footer-settings-controls:has(:global(#analytics-notice:not([hidden])))
    :global(.analytics-settings) {
    flex-basis: 100%;
  }

  .footer-settings :global(button[data-preferences]) {
    display: inline-block;
    margin: 0;
    padding: 0;
    border: 0;
    background: transparent;
    color: var(--pj-link, currentColor);
    text-decoration: underline;
    text-underline-offset: .16em;
  }

  [data-footer-settings-toggle]:focus-visible {
    outline: 2px solid var(--pj-link, currentColor);
    outline-offset: 3px;
  }
</style>
