---
import { SITE_TITLE } from '../consts';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const measurementId = 'G-PSX1XWCWD7';
const analyticsEnabled = import.meta.env.PROD && /^G-[A-Z0-9]+$/.test(measurementId);
---

<footer class="portfolio-footer">
  <span>© {new Date().getFullYear()} {SITE_TITLE}</span>
  <div class="portfolio-links">
    <a href={`${base}/privacy/`}>Privacy</a>
    <a href="https://github.com/szaka">GitHub</a>
  </div>

  {analyticsEnabled && (
    <div class="analytics-choice" data-measurement-id={measurementId}>
      <button type="button" data-toggle>Analytics preferences</button>
      <div data-options hidden>
        <p>Allow Google Analytics to measure visits to this site?</p>
        <button type="button" data-allow>Allow analytics</button>
        <button type="button" data-decline>Decline analytics</button>
      </div>
    </div>
  )}
</footer>

<style>
  .analytics-choice { width: 100%; }
  .analytics-choice button { font: inherit; cursor: pointer; }
  .analytics-choice p { margin-block: 0.5rem; }
</style>

<script>
  const preference = document.querySelector<HTMLElement>('.analytics-choice');
  const id = preference?.dataset.measurementId;
  const options = preference?.querySelector<HTMLElement>('[data-options]');
  const key = 'portfolio-analytics-choice';

  if (preference && options && id) {
    const loadAnalytics = () => {
      if (document.getElementById('portfolio-ga4')) return;

      const analytics = window as Window & { dataLayer?: unknown[] };
      analytics.dataLayer ??= [];
      function gtag(..._args: unknown[]) {
        analytics.dataLayer?.push(arguments);
      }
      gtag('js', new Date());
      gtag('config', id, { allow_google_signals: false, allow_ad_personalization_signals: false });

      const tag = document.createElement('script');
      tag.id = 'portfolio-ga4';
      tag.async = true;
      tag.src = `https://www.googletagmanager.com/gtag/js?id=${encodeURIComponent(id)}`;
      document.head.append(tag);
    };

    if (localStorage.getItem(key) === 'allow') loadAnalytics();

    preference.querySelector('[data-toggle]')?.addEventListener('click', () => {
      options.hidden = !options.hidden;
    });
    preference.querySelector('[data-allow]')?.addEventListener('click', () => {
      localStorage.setItem(key, 'allow');
      loadAnalytics();
      options.hidden = true;
    });
    preference.querySelector('[data-decline]')?.addEventListener('click', () => {
      const wasActive = localStorage.getItem(key) === 'allow';
      localStorage.setItem(key, 'decline');
      if (wasActive) location.reload();
      else options.hidden = true;
    });
  }
</script>
