---
import type { HTMLAttributes } from 'astro/types';

type Props = HTMLAttributes<'a'>;

const { href, class: className, ...props } = Astro.props;
const pathname = Astro.url.pathname.replace(/\/$/, '');
const destination = typeof href === 'string' ? href.replace(/\/$/, '') : undefined;
const isCurrent = destination === pathname;
const isActive = isCurrent || Boolean(destination && pathname.startsWith(destination + '/'));
---

<a href={href} class:list={[className, { active: isActive }]} {...props} aria-current={isCurrent ? 'page' : undefined}>
	<slot />
</a>
<style>
	a {
		display: inline-block;
		text-decoration: none;
	}
	a.active {
		font-weight: bolder;
		text-decoration: underline;
	}
</style>
