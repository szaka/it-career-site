---
import '../styles/site-controls.css';
// Import the global.css file here so that it is included on
// all pages through the use of the <BaseHead /> component.
import '../styles/global.css';
import type { ImageMetadata } from 'astro';
import FallbackImage from '../assets/blog-placeholder-1.jpg';
import { SITE_TITLE } from '../consts';
import { Font } from 'astro:assets';

interface Props {
	title: string;
	description: string;
	image?: ImageMetadata;
}

const canonicalURL = new URL(Astro.url.pathname, Astro.site);

const { title, description, image = FallbackImage } = Astro.props;
---

<!-- Global Metadata -->
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width,initial-scale=1" />
<link rel="icon" type="image/svg+xml" href="/sz-favicon.svg" />
<link rel="sitemap" href="/sitemap-index.xml" />
<link
	rel="alternate"
	type="application/rss+xml"
	title={SITE_TITLE}
	href={new URL('rss.xml', Astro.site)}
/>
<meta name="generator" content={Astro.generator} />

<Font cssVariable="--font-atkinson" preload />

<!-- Canonical URL -->
<link rel="canonical" href={canonicalURL} />

<!-- Primary Meta Tags -->
<title>{title}</title>
<meta name="description" content={description} />

<!-- Open Graph / Facebook -->
<meta property="og:type" content="website" />
<meta property="og:url" content={canonicalURL} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:image" content={new URL(image.src, canonicalURL)} />

<!-- Twitter -->
<meta name="twitter:card" content="summary_large_image" />

<script is:inline>
  try {
    var appearance = localStorage.getItem('portfolio-home-appearance');
    if (appearance === 'light' || appearance === 'dark') {
      document.documentElement.dataset.siteAppearance = appearance;
    }
  } catch {}
</script>

<!-- Topic selectors for Blog and Projects -->
<script>
  const listing = location.pathname.replace(/\/$/, '').split('/').pop();

  if (listing === 'blog' || listing === 'projects') {
    const main = document.querySelector('main');

    const installTopicSelector = () => {
      if (!main) return false;
      const allLabel = listing === 'blog' ? 'All posts' : 'All projects';
      const allButton = [...main.querySelectorAll<HTMLButtonElement>('button[aria-pressed]')]
        .find((button) => button.textContent?.trim() === allLabel);
      const group = allButton?.parentElement;
      if (!group || !allButton) return false;

      const buttons = [...group.querySelectorAll<HTMLButtonElement>('button[aria-pressed]')];
      if (buttons.length < 2) return false;

      const label = document.createElement('label');
      label.className = 'listing-topic-selector';
      label.append('Topic');

      const select = document.createElement('select');
      for (const [index, button] of buttons.entries()) {
        select.add(new Option(
          button === allButton ? 'All topics' : button.textContent?.trim() ?? '',
          String(index),
        ));
      }

      const sync = () => {
        const selected = buttons.findIndex((button) => button.getAttribute('aria-pressed') === 'true');
        select.selectedIndex = selected < 0 ? buttons.indexOf(allButton) : selected;
      };

      select.addEventListener('change', () => buttons[select.selectedIndex]?.click());
      const selectionObserver = new MutationObserver(sync);
      for (const button of buttons) {
        selectionObserver.observe(button, { attributes: true, attributeFilter: ['aria-pressed'] });
      }

      sync();
      label.append(select);
      group.prepend(label);
      group.classList.add('listing-topic-group');
      for (const button of buttons) button.hidden = true;
      return true;
    };

    if (main && !installTopicSelector()) {
      const toolbarObserver = new MutationObserver(() => {
        if (installTopicSelector()) toolbarObserver.disconnect();
      });
      toolbarObserver.observe(main, {
        childList: true, subtree: true, attributes: true, attributeFilter: ['aria-pressed'],
      });
    }
  }
</script>

<style is:global>
  .listing-topic-group button[hidden] {
    display: none !important;
  }

  /* Wider listing search */
  .blog-search[data-blog-search-controls] > #blog-search,
  .listing-topic-group ~ :has(input[type="search"]) input[type="search"],
  .listing-topic-group ~ input[type="search"] {
    box-sizing: border-box;
    width: 100%;
    max-width: none;
    min-width: 0;
  }

  .listing-topic-group ~ :has(input[type="search"]),
  .listing-topic-group ~ input[type="search"] {
    flex: 1 1 16rem;
    min-width: 0;
  }

  @media (min-width: 42rem) {
    .blog-search[data-blog-search-controls]:has(.listing-topic-group) {
      grid-template-columns: max-content minmax(0, 1fr);
    }
  }

  @media (max-width: 41.99rem) {
    .listing-topic-group ~ :has(input[type="search"]),
    .listing-topic-group ~ input[type="search"] {
      flex-basis: 100%;
    }
  }

  .listing-topic-selector {
    display: inline-grid;
    gap: .35rem;
    font-size: .875rem;
  }

  body main .listing-topic-selector select {
    min-height: 44px;
    min-width: 10rem;
    max-width: 100%;
    padding-inline: .65rem;
    border: 1px solid var(--control-border, var(--pj-line));
    border-radius: var(--control-radius, .35rem);
    background: var(--pj-card);
    color: var(--pj-ink);
    font: inherit;
  }
</style>
