---
import { SITE_TITLE } from '../consts';
import HeaderLink from './HeaderLink.astro';
import '../styles/portfolio.css';
import '../styles/article-reading.css';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<header class="portfolio-header">
  <nav aria-label="Main navigation">
    <a class="site-name" href={`${base}/`}>{SITE_TITLE}</a>
    <div class="portfolio-links">
      <HeaderLink href={`${base}/projects/`}>Projects</HeaderLink>
      <HeaderLink href={`${base}/blog/`}>Blog</HeaderLink>
      <HeaderLink href={`${base}/about/`}>About</HeaderLink>
    </div>
  </nav>
</header>

<script>
  if (navigator.clipboard?.writeText) {
    for (const code of document.querySelectorAll('main pre > code')) {
      const pre = code.parentElement;
      if (!pre || pre.parentElement?.classList.contains('code-with-copy')) continue;

      const group = document.createElement('div');
      group.className = 'code-with-copy';
      pre.before(group);

      const button = document.createElement('button');
      button.type = 'button';
      button.className = 'code-copy-button';
      button.textContent = 'Copy code';
      button.addEventListener('click', async () => {
        try {
          await navigator.clipboard.writeText(code.textContent?.trimEnd() ?? '');
          button.textContent = 'Copied';
        } catch {
          button.textContent = 'Select code to copy';
        }
      });

      group.append(button, pre);
    }
  }
</script>
